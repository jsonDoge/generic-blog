# Copy to .env and fill in. NEVER commit .env (it's git-ignored).
#
# These are LOCAL credentials for provisioning/testing from your machine or CI.
# Worker runtime secrets (ADMIN_TOKEN, BRAVE_API_KEY) are NOT set here — they
# live in Cloudflare via `wrangler secret put` (or apps/pipeline/.dev.vars for
# local wrangler dev; see .dev.vars.example).

# Cloudflare account ID — dashboard right sidebar, or `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# API token (dash.cloudflare.com -> My Profile -> API Tokens).
# Wrangler and provision.sh read this exact variable name; if it's set you
# don't need `npx wrangler login`.
# Scopes needed for provisioning + deploys (Account-level, Edit):
#   Workers Scripts, D1, Workers R2 Storage, Vectorize, Workers AI
CLOUDFLARE_API_TOKEN=

# Optional: a separate token scoped ONLY to Workers AI (Read), for testing
# model calls via the REST API without exposing broader permissions.
# CLOUDFLARE_WORKER_API_TOKEN=
