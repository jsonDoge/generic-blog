---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { config } from "@blog-flow/shared";
import { listPublished } from "../../lib/db";

const { category } = Astro.params;
if (!category || !config.niche.categories.includes(category)) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const posts = await listPublished(Astro.locals.runtime.env.BLOG_DB, {
  category,
  limit: 24,
});
const label = category.charAt(0).toUpperCase() + category.slice(1);
const path = `/category/${category}/`;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=3600",
);
---

<Base
  title={`${label} – All ${label} Articles | ${config.name}`}
  description={`All ${config.name} articles in ${label}, about ${config.niche.topic}. Newest first.`}
  path={path}
  jsonLd={[
    {
      "@type": "CollectionPage",
      "@id": new URL(path, config.siteUrl).href,
      name: label,
      url: new URL(path, config.siteUrl).href,
      isPartOf: { "@id": `${config.siteUrl}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${config.siteUrl}/` },
        { "@type": "ListItem", position: 2, name: label },
      ],
    },
  ]}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">{label}</li>
      </ol>
    </nav>
  </div>

  <section class="hero container" style="padding-block: 2rem var(--space-section);">
    <h1>{label}</h1>
    <p class="hero__lede">Everything we've published in {label.toLowerCase()}.</p>
  </section>

  <section class="section container" aria-label={`Articles in ${label}`}>
    {
      posts.length === 0 ? (
        <p>No articles in this category yet — check back soon.</p>
      ) : (
        <ul class="post-grid" style="list-style: none; padding: 0;">
          {posts.map((p, i) => (
            <li>
              <PostCard post={p} eager={i === 0} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
