---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { config } from "@blog-flow/shared";
import { listPublished } from "../lib/db";

const posts = await listPublished(Astro.locals.runtime.env.BLOG_DB, { limit: 7 });
const [featured, ...rest] = posts;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=3600",
);
---

<Base
  title={`${config.name} – ${config.tagline}`}
  description={config.description}
  path="/"
>
  <section class="hero container">
    <p class="hero__kicker">The {config.name} journal</p>
    <h1>{config.tagline}</h1>
    <p class="hero__lede">{config.description}</p>
  </section>

  <section class="section container" aria-labelledby="latest-heading">
    <div class="section__head">
      <h2 id="latest-heading">Latest articles</h2>
      <a href="/blog/">View all articles →</a>
    </div>

    {
      posts.length === 0 ? (
        <p>
          No published posts yet. Run the pipeline (or approve a draft in the
          admin UI) and this page fills itself.
        </p>
      ) : (
        <ul class="post-grid" style="list-style: none; padding: 0;">
          {featured && (
            <li>
              <PostCard post={featured} featured headingLevel="h3" eager />
            </li>
          )}
          {rest.map((p) => (
            <li>
              <PostCard post={p} headingLevel="h3" />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
